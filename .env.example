# ══════════════════════════════════════
# MakonTV Environment Variables
# ══════════════════════════════════════

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/makontv?sslmode=require

# API
PORT=3001
NODE_ENV=development

# Admin access (temporary, before auth)
# Auth
JWT_SECRET=your-jwt-secret-min-32-chars-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=your-refresh-secret-different-from-jwt-secret
ADMIN_SECRET=changeme-makontv-admin-2025

# Storage (Cloudflare R2 or any S3-compatible)
# For R2: https://dash.cloudflare.com → R2 → Create bucket → API Tokens
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=makontv
S3_ACCESS_KEY=your_r2_access_key
S3_SECRET_KEY=your_r2_secret_key
S3_REGION=auto
S3_PUBLIC_URL=https://pub-xxxx.r2.dev

# Auth (Этап 8)
# JWT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
