{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/api/src/server.ts"
    }
  ],
  "env": {
    "DATABASE_URL": "@makontv_database_url",
    "JWT_SECRET": "@makontv_jwt_secret",
    "JWT_REFRESH_SECRET": "@makontv_jwt_refresh_secret",
    "ADMIN_SECRET": "@makontv_admin_secret",
    "S3_ENDPOINT": "@makontv_s3_endpoint",
    "S3_BUCKET": "@makontv_s3_bucket",
    "S3_ACCESS_KEY": "@makontv_s3_access_key",
    "S3_SECRET_KEY": "@makontv_s3_secret_key",
    "S3_PUBLIC_URL": "@makontv_s3_public_url"
  }
}
